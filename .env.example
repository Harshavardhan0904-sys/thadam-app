# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RAZORPAY_KEY_ID: Razorpay Key ID for payments (safe for client / public configuration).
RAZORPAY_KEY_ID=""

# RAZORPAY_KEY_SECRET: Razorpay Key Secret for HMAC SHA-256 server-side signature verification.
# CRITICAL: Keep server-side secret only! Never expose in client code.
RAZORPAY_KEY_SECRET=""

# VITE_RAZORPAY_KEY_ID: Public Razorpay Key ID for client-side checkout modal.
VITE_RAZORPAY_KEY_ID=""

# RAZORPAY_TEST_MODE: Set to "true" to allow test-mode payment simulation in development.
# CRITICAL: NEVER set to "true" in production!
RAZORPAY_TEST_MODE="true"
